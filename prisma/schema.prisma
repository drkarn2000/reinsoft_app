// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -----------------------------------------------------------------------------
// 1. AUTHENTICATION & ADMIN ROLES
// -----------------------------------------------------------------------------
enum UserRole {
  SUPER_ADMIN
  EDITOR
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         UserRole  @default(EDITOR)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs    AuditLog[]

  @@map("admin_users")
}

// -----------------------------------------------------------------------------
// 2. GLOBAL SITE SETTINGS & NAVIGATION
// -----------------------------------------------------------------------------
model SiteSetting {
  id                 String   @id @default("global")
  companyName        String   @default("Reinsoft IT Solutions")
  tagline            String   @default("Custom Software & IT Solutions for Growing Businesses")
  contactEmail       String   @default("info@reinsoft.tech")
  contactPhone       String   @default("+91 89683 69582")
  whatsappNumber     String   @default("918968369582")
  whatsappMessage    String   @default("Hello Reinsoft team, I would like to discuss a project.")
  address            String?
  gtmId              String   @default("GTM-PCJ2MX8P")
  gaId               String   @default("G-DHTF1C42M2")
  googleVerification String   @default("t1SU8KB5y2PwBXx6oFYDV4IoIiJ55nlIEqPu5b_s5sM")
  defaultSeoTitle    String   @default("AI & Custom Software Development | Reinsoft")
  defaultSeoDesc     String   @default("Reinsoft provides custom software, AI-powered mobile apps, and scalable web development.")
  defaultSeoKeywords String   @default("custom software development, AI app development, web development")
  canonicalBaseUrl   String   @default("https://reinsoft.tech")
  updatedAt          DateTime @updatedAt

  @@map("site_settings")
}

enum MenuLocation {
  NAVBAR_MAIN
  NAVBAR_SERVICES_DROPDOWN
  FOOTER_QUICK_LINKS
  FOOTER_EXPLORE_LINKS
}

model NavigationItem {
  id           String          @id @default(cuid())
  location     MenuLocation
  label        String
  href         String
  iconName     String?         // Lucide icon identifier (e.g., CodeIcon, SmartphoneIcon)
  description  String?         // Used in services mega-menu
  sortOrder    Int             @default(0)
  isEnabled    Boolean         @default(true)
  openInNewTab Boolean         @default(false)
  parentId     String?
  parent       NavigationItem? @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     NavigationItem[] @relation("MenuHierarchy")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([location, sortOrder])
  @@map("navigation_items")
}

// -----------------------------------------------------------------------------
// 3. PAGES & SECTION-BASED ENGINE
// -----------------------------------------------------------------------------
enum PageType {
  HOME
  ABOUT
  SERVICES_HUB
  SERVICE_DETAIL
  PORTFOLIO
  OUR_WORK
  TESTIMONIALS
  CONTACT
  LOCATION_LANDING
  HIRE_DEVELOPERS
  PPC_LANDING
  LEGAL
  CUSTOM
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Page {
  id             String        @id @default(cuid())
  slug           String        @unique // e.g., "", "about", "services/web-development"
  title          String
  pageType       PageType      @default(CUSTOM)
  status         PublishStatus @default(PUBLISHED)
  publishedAt    DateTime?     @default(now())

  // SEO Metadata
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  canonicalUrl   String?
  ogImageUrl     String?
  noIndex        Boolean       @default(false)

  // Sections
  sections       PageSection[]

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([slug, status])
  @@map("pages")
}

enum SectionType {
  HERO
  BRANDS_SLIDER
  TRUST_STRIP
  WHY_CHOOSE_US
  FEATURES_OVERVIEW
  WORKFLOW_STEPS
  PORTFOLIO_GRID
  TEAM_GRID
  FOUNDERS_STORY
  TESTIMONIALS_CAROUSEL
  FAQ_ACCORDION
  CALL_TO_ACTION
  INDUSTRIES_GRID
  ABOUT_HERO
  ABOUT_STORY
  ABOUT_VISION
  ABOUT_SERVICES
  ABOUT_TECH_STACK
  ABOUT_PROCESS
  SERVICE_HERO
  SERVICE_DELIVERABLES
  LOCATION_HERO
  HIRE_HERO
  HIRE_COMPARISON
  RICH_TEXT_LEGAL
  CUSTOM_JSON
}

model PageSection {
  id          String      @id @default(cuid())
  pageId      String
  page        Page        @relation(fields: [pageId], references: [id], onDelete: Cascade)
  sectionType SectionType
  name        String?     // Editorial helper label, e.g., "Homepage Hero"
  sortOrder   Int         @default(0)
  isEnabled   Boolean     @default(true)

  // Design/layout configuration (e.g., variant, theme overrides, padding)
  settings    Json?       @default("{}")

  // Typed section payload (headlines, copy, image paths, button targets)
  content     Json        @default("{}")

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([pageId, sortOrder])
  @@map("page_sections")
}

// -----------------------------------------------------------------------------
// 4. CASE STUDIES & PORTFOLIO REPOSITORY
// -----------------------------------------------------------------------------
model CaseStudy {
  id               String        @id @default(cuid())
  slug             String        @unique
  title            String
  clientName       String?
  liveLink         String?
  shortDescription String
  industry         String
  category         String        // "Web Development", "Mobile Applications", "Custom Software"
  techStack        String[]      // e.g. ["Next.js", "Tailwind CSS", "Stripe"]
  heroImage        String
  overview         String
  problem          String
  solution         String

  // Structured content blocks
  features         Json          @default("[]") // [{ title, points: [], icon }]
  processStages    Json          @default("[]") // [{ stage, description, points: [] }]
  results          Json          @default("[]") // [{ metric, value }]
  screenshots      Json          @default("[]") // [{ title, url }]

  // Custom Section Headings & Content
  overviewHeading  String?       @default("Project Overview")
  problemHeading   String?       @default("The Problem")
  solutionHeading  String?       @default("The Solution")

  // Final Call to Action
  ctaTitle         String?       @default("Ready to achieve similar results?")
  ctaDescription   String?       @default("Let's discuss how we can bring your vision to life with a high-performance digital solution.")
  ctaButtonText    String?       @default("Start Your Project")
  ctaButtonUrl     String?       @default("/#contact")

  isFeatured       Boolean       @default(false)
  sortOrder        Int           @default(0)
  status           PublishStatus @default(PUBLISHED)

  seoTitle         String?
  seoDescription   String?

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([slug, status])
  @@map("case_studies")
}

// -----------------------------------------------------------------------------
// 5. TESTIMONIALS & VIDEO REVIEWS
// -----------------------------------------------------------------------------
model Testimonial {
  id               String        @id @default(cuid())
  clientName       String
  role             String
  companyName      String?
  location         String
  countryCode      String        // e.g. "in", "us", "gb", "za"
  rating           Int           @default(5)
  reviewText       String
  projectType      String
  resultBadgeText  String?       // e.g. "+42% Conversion Growth"
  resultBadgeColor String?       // e.g. "text-green-600 bg-green-100"
  avatarImage      String?
  caseStudyLink    String?

  // Video testimonial fields
  isVideo          Boolean       @default(false)
  videoUrl         String?       // Path to local MP4 or remote video
  subtitleVttUrl   String?       // Path to .vtt subtitles
  videoThumbnail   String?

  isFeatured       Boolean       @default(false)
  sortOrder        Int           @default(0)
  status           PublishStatus @default(PUBLISHED)

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status, isFeatured])
  @@map("testimonials")
}

// -----------------------------------------------------------------------------
// 6. BRAND LOGOS & CLIENT TICKER
// -----------------------------------------------------------------------------
model BrandLogo {
  id          String   @id @default(cuid())
  name        String
  logoUrl     String
  rowNumber   Int      @default(1) // Row 1 or Row 2 in Marquee
  customClass String?  // Optional sizing / mix-blend utility
  bgClass     String?  // Optional container style, e.g. "bg-gray-900"
  sortOrder   Int      @default(0)
  isEnabled   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([rowNumber, sortOrder])
  @@map("brand_logos")
}

// -----------------------------------------------------------------------------
// 7. TEAM & LEADERSHIP
// -----------------------------------------------------------------------------
model TeamMember {
  id             String   @id @default(cuid())
  name           String
  role           String   // e.g. "Founder & CEO"
  focusArea      String?  // e.g. "Vision & Growth"
  bio            String
  imageUrl       String
  accentGradient String?  // e.g. "from-[#c6a86a] via-[#e7d2a3] to-[#f5ead3]"
  linkedinUrl    String?
  isFounder      Boolean  @default(false)
  sortOrder      Int      @default(0)
  isEnabled      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("team_members")
}

// -----------------------------------------------------------------------------
// 8. FAQS POOL
// -----------------------------------------------------------------------------
model FaqItem {
  id        String   @id @default(cuid())
  category  String   @default("general") // "general", "services", "pricing"
  question  String
  answer    String
  sortOrder Int      @default(0)
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, sortOrder])
  @@map("faq_items")
}

// -----------------------------------------------------------------------------
// 9. MEDIA ASSET REGISTRY
// -----------------------------------------------------------------------------
model MediaAsset {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  sizeBytes    Int
  url          String   // e.g. "/assets/hero-bg.jpg" or CDN URL
  altText      String?
  folder       String   @default("general") // "testimonials", "case-studies", "brands", "team"
  width        Int?
  height       Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([folder])
  @@map("media_assets")
}

// -----------------------------------------------------------------------------
// 10. FORM SUBMISSIONS STORAGE
// -----------------------------------------------------------------------------
enum SubmissionType {
  GENERAL_CONTACT
  LEAD_FORM
  QUOTE_REQUEST
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED
  ARCHIVED
}

model FormSubmission {
  id          String         @id @default(cuid())
  type        SubmissionType @default(GENERAL_CONTACT)
  name        String
  email       String
  phone       String?
  companyName String?
  enquiryType String?
  budget      String?
  message     String
  status      LeadStatus     @default(NEW)
  notes       String?
  ipAddress   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([type, status, createdAt])
  @@map("form_submissions")
}

// -----------------------------------------------------------------------------
// 11. AUDIT LOGGING
// -----------------------------------------------------------------------------
model AuditLog {
  id        String    @id @default(cuid())
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String    // e.g. "UPDATE_PAGE", "PUBLISH_CASE_STUDY"
  targetId  String?
  details   Json?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("audit_logs")
}
